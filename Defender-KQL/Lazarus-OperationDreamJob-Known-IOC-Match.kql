// Title: Lazarus "Operation Dream Job" - Known IOC Match (Domains + Filenames)
// Description: Matches endpoint telemetry against published indicators for
//   the August 2026 Operation Dream Job campaign: fake "Enveil" recruiter
//   domains used for the initial lure/payload delivery, and filenames
//   belonging to the Troy backdoor's plugin set (GetInfoPlugin, PvPlugin,
//   OneScreenCapture) and the libmupdf.dll side-loading DLL.
// MITRE ATT&CK: T1583.001 (Acquire Infrastructure: Domains), T1105 (Ingress
//   Tool Transfer), T1113 (Screen Capture), T1057 (Process Discovery),
//   T1082 (System Information Discovery)
// Data source: Microsoft Defender for Endpoint (DeviceNetworkEvents,
//   DeviceFileEvents)
// False positives: Effectively none for the domain matches (purpose-built
//   lookalike domains). This is a point-in-time IOC list, not a behavioral
//   detection - it will stop matching once the actor rotates infrastructure.
//   Treat hits as high-confidence but keep the indicator lists refreshed
//   from current threat intel.

let IOCDomains = dynamic(["envell.xyz", "enveil.online", "uxtramine.org"]);
let IOCFiles = dynamic([
    "libmupdf.dll", "Release_GetInfoPlugin_x64.dll",
    "Release_PvPlugin_x64.dll", "OneScreenCapture64.dll"
]);
union
(DeviceNetworkEvents
| where RemoteUrl has_any (IOCDomains)
| project Timestamp, DeviceName, MatchType = "Domain", Indicator = RemoteUrl,
    InitiatingProcessFileName, InitiatingProcessCommandLine, InitiatingProcessAccountName),
(DeviceFileEvents
| where FileName in~ (IOCFiles)
| project Timestamp, DeviceName, MatchType = "Filename", Indicator = FileName,
    InitiatingProcessFileName, InitiatingProcessCommandLine, InitiatingProcessAccountName)
| order by Timestamp desc
